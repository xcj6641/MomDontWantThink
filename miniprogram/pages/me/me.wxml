<view class="page">

  <!-- 宝宝信息卡 -->
  <view class="baby-bar">
    <text class="baby-bar-icon" wx:if="{{hasPrefs}}">👶</text>
    <view class="baby-bar-top {{hasPrefs ? '' : 'baby-bar-top--full'}}">
      <view class="baby-bar-head" wx:if="{{hasPrefs}}">
        <text class="baby-bar-main">宝宝 · {{babyAgeMonths}}个月</text>
        <text class="baby-bar-meal">{{mealCount}}餐/天</text>
        <text class="baby-bar-allergen" wx:if="{{teethStageLine}}">{{teethStageLine}}</text>
        <text class="baby-bar-allergen" wx:if="{{allergyText}}">{{allergyText}}</text>
        <text class="baby-bar-allergen" wx:if="{{allergyModeLine}}">{{allergyModeLine}}</text>
      </view>
      <view class="baby-bar-head" wx:else>
        <text class="baby-bar-main baby-bar-main--muted">还没有宝宝信息</text>
      </view>
      <view class="baby-bar-actions">
        <text class="baby-bar-edit-btn" bindtap="onEditProfile">{{hasPrefs ? '编辑' : '去填写'}}</text>
      </view>
    </view>
  </view>

  <!-- 宝宝 -->
  <view class="list-card">
    <view class="list-item" bindtap="onNavLogs">
      <image class="list-item__icon" src="/assets/icons/me/logs.svg" mode="aspectFit"/>
      <view class="list-item__body">
        <text class="list-item__title">进食记录</text>
      </view>
      <text class="list-item__arrow">›</text>
    </view>
    <view class="list-divider"></view>
    <view class="list-item" bindtap="onNavAllergy">
      <image class="list-item__icon" src="/assets/icons/me/allergy.svg" mode="aspectFit"/>
      <view class="list-item__body">
        <text class="list-item__title">过敏信息</text>
        <text class="list-item__count" wx:if="{{allergyText}}">{{allergyText}}</text>
      </view>
      <text class="list-item__arrow">›</text>
    </view>
  </view>

  <!-- 我的内容 -->
  <view class="list-card">
    <view class="list-item" bindtap="onNavLiked">
      <image class="list-item__icon" src="/assets/icons/me/liked.svg" mode="aspectFit"/>
      <view class="list-item__body">
        <text class="list-item__title">宝宝喜欢</text>
        <text class="list-item__count" wx:if="{{likedCount}}">{{likedCount}} 个菜品</text>
      </view>
      <text class="list-item__arrow">›</text>
    </view>
    <view class="list-divider"></view>
    <view class="list-item" bindtap="onNavMyRecipes">
      <image class="list-item__icon" src="/assets/icons/me/recipes.svg" mode="aspectFit"/>
      <view class="list-item__body">
        <text class="list-item__title">我的菜谱</text>
        <text class="list-item__count">{{myRecipeCount ? myRecipeCount + ' 个菜谱' : '还没有，去添加 →'}}</text>
      </view>
      <text class="list-item__arrow">›</text>
    </view>
    <view class="list-divider"></view>
    <view class="list-item" bindtap="onNavSavedRecipes">
      <image class="list-item__icon" src="/assets/icons/me/saved-recipes.svg" mode="aspectFit"/>
      <view class="list-item__body">
        <text class="list-item__title">收藏的菜谱</text>
        <text class="list-item__count" wx:if="{{savedRecipeCount}}">{{savedRecipeCount}} 个菜谱</text>
      </view>
      <text class="list-item__arrow">›</text>
    </view>
    <view class="list-divider"></view>
    <view class="list-item" bindtap="onNavSavedPlans">
      <image class="list-item__icon" src="/assets/icons/me/saved-plans.svg" mode="aspectFit"/>
      <view class="list-item__body">
        <text class="list-item__title">收藏的周计划</text>
        <text class="list-item__count" wx:if="{{savedPlanCount}}">{{savedPlanCount}} 个计划</text>
      </view>
      <text class="list-item__arrow">›</text>
    </view>
  </view>

  <!-- 设置 -->
  <view class="list-card">
    <view class="list-item" bindtap="onGoToFoodSettings">
      <image class="list-item__icon" src="/assets/icons/me/settings.svg" mode="aspectFit"/>
      <view class="list-item__body">
        <text class="list-item__title">辅食设置</text>
        <text class="list-item__count">排敏模式、月龄偏好等</text>
      </view>
      <text class="list-item__arrow">›</text>
    </view>
    <view class="list-divider"></view>
    <view class="list-item" bindtap="onNavReminder">
      <image class="list-item__icon" src="/assets/icons/me/reminder.svg" mode="aspectFit"/>
      <view class="list-item__body">
        <text class="list-item__title">备餐提醒</text>
      </view>
      <text class="list-item__arrow">›</text>
    </view>
    <view class="list-divider"></view>
    <view class="list-item" bindtap="onNavAbout">
      <image class="list-item__icon" src="/assets/icons/me/about.svg" mode="aspectFit"/>
      <view class="list-item__body">
        <text class="list-item__title">关于我们</text>
      </view>
      <text class="list-item__arrow">›</text>
    </view>
    <view class="list-divider"></view>
    <view class="list-item">
      <image class="list-item__icon" src="/assets/icons/me/settings.svg" mode="aspectFit"/>
      <view class="list-item__body">
        <text class="list-item__title">Mock 模式</text>
        <text class="list-item__count">周计划本地模拟</text>
      </view>
      <switch checked="{{useMockWeekPlan}}" bindchange="onMockModeChange" color="#7fb77e" />
    </view>
  </view>

  <view class="safe-area"></view>
</view>
