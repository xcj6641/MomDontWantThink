.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

/* 宝宝信息卡 — grid: icon列(max-content) + 内容列(1fr)，遵循头部信息区规范 */
.baby-bar {
  display: grid;
  grid-template-columns: max-content 1fr;
  column-gap: 20rpx;
  row-gap: 0;
  align-items: start;
  background: linear-gradient(165deg, #fbfdf9 0%, #eef6f1 40%, #dff5ea 100%);
  border: 2rpx solid rgba(160, 216, 192, 0.40);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 20rpx rgba(47, 94, 59, 0.05);
}

/* 左列：emoji，顶部对齐 */
.baby-bar-icon {
  font-size: 44rpx;
  line-height: 1;
}

/* 右列：flex行，内容靠左，操作靠右，底部对齐（同 todayFood） */
.baby-bar-top {
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.baby-bar-top--full {
  grid-column: 1 / -1;
}

/* 文字纵向堆叠 */
.baby-bar-head {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.baby-bar-main {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #2f5e3b;
}

.baby-bar-main--muted {
  color: #7d8b80;
  font-weight: 400;
}

.baby-bar-meal {
  display: block;
  font-size: 24rpx;
  color: #7d8b80;
  line-height: 1.45;
}

.baby-bar-allergen {
  display: block;
  font-size: 24rpx;
  color: #7d8b80;
  line-height: 1.45;
}

/* 操作列：右对齐，底部对齐 */
.baby-bar-actions {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.baby-bar-edit-btn {
  font-size: 26rpx;
  font-weight: 500;
  color: #6ba86a;
  line-height: 1.35;
}

.baby-bar-edit-btn:active {
  opacity: 0.55;
}


/* 列表卡片 */
.list-card {
  background: #fff;
  border-radius: 32rpx;
  border: 1rpx solid #e4ede6;
  box-shadow: 0 4rpx 16rpx rgba(90, 120, 95, 0.05);
  overflow: hidden;
  margin-bottom: 32rpx;
}

.list-divider {
  height: 1rpx;
  background: rgba(160, 216, 192, 0.25);
  margin: 0 32rpx;
}

/* 列表行 */
.list-item {
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  min-height: 96rpx;
}

.list-item__icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.list-item__body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.list-item__title {
  font-size: 28rpx;
  color: #2f3a35;
}

.list-item__count {
  font-size: 24rpx;
  color: #7d8b80;
}

.list-item__arrow {
  font-size: 32rpx;
  color: #c0ccc4;
  margin-left: 8rpx;
}

/* 底部安全区 */
.safe-area {
  height: calc(32rpx + env(safe-area-inset-bottom));
}
